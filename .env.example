# Required for the LLM-backed extraction and reranking stages. Supply the key for
# every provider llm.model_providers in config/settings.yaml routes a model to.
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# Local services started by docker-compose.yml.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=capgraph-local
MYSQL_URL=mysql+pymysql://root:capgraph-local@localhost:3306/tawos
